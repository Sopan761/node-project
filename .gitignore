# Local Netlify folder
.netlify
# Node modules
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# System files
.DS_Store
Thumbs.db

# dotenv environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE settings
.vscode/
.idea/

# Testing coverage
coverage/

# Misc
.cache/
*.log
*.tgz

# Nodemon auto-reload files
*.swp
*.swo
*.tmp

# Nodemon-generated watch files (rare, but safe to add)
.nodemonignore

# OS-specific metadata
ehthumbs.db
Desktop.ini

# MongoDB data directory (if running with --dbpath ./data)
/data/
/data/db/
/dump/

# PM2 or log folders if using
pm2.log
logs/
*.log

# IDEs and editors
*.sublime-workspace
*.sublime-project
*.code-workspace

